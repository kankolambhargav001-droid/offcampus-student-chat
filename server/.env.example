# Comma-separated Firebase Authentication emails allowed to access /admin.
ADMIN_EMAILS=your-admin-email@example.com

# Firebase service account JSON for the SAME Firebase project as the frontend.
# Keep this secret. Never commit a real value to GitHub or put it in the frontend.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"offcampus-student-chat",...}
